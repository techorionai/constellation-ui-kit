{
  "name": "@techorionai/constellation-ui-kit",
  "version": "0.0.0-development",
  "description": "Shared React and Mantine UI kit of the Constellation platform.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/techorionai/constellation-ui-kit.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./styles.css": "./dist/styles.css",
    "./color-scheme.js": "./dist/color-scheme.js"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "tsc --noEmit && eslint . && prettier --check .",
    "test": "vitest run",
    "build": "vite build",
    "prepack": "npm run build",
    "test:integration": "node tests/integration/run.mjs"
  },
  "peerDependencies": {
    "@mantine/core": "^9.0.0",
    "@mantine/hooks": "^9.0.0",
    "@mantine/notifications": "^9.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": ">=6"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.1",
    "@eslint/js": "9.39.5",
    "@mantine/core": "9.8.2",
    "@mantine/hooks": "9.8.2",
    "@mantine/notifications": "9.8.2",
    "@playwright/test": "1.65.1",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "24.0.0",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "testcontainers": "12.2.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.4.0",
    "vite-plugin-dts": "5.1.2",
    "vitest": "5.1.0",
    "vitest-axe": "0.1.0"
  },
  "dependencies": {
    "oauth4webapi": "3.8.9"
  }
}
